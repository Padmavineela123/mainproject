MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret_key
PORT=5000

ADMIN_EMAIL=admin@aiinterviewprep.com
ADMIN_PASSWORD=your_admin_password

# Comma-separated list of client origins allowed by CORS.
# For production, set this to your deployed frontend URL (e.g. https://your-app.vercel.app)
CLIENT_ORIGINS=http://localhost:5173

# Compiler path (used by coding practice). On Linux cloud servers (Render/Railway), leave as /usr/bin/gcc
GCC_PATH=/usr/bin/gcc
